{% extends 'base.html.twig' %}

{% block title %}Independent Age — Records{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Independent Age — Records</h2>
            <a href="{{ path('app_independent_age_new') }}" class="btn btn-primary">New record</a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mt-3">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="table-responsive mt-3">
            <table class="table table-sm table-striped align-middle">
                <thead>
                <tr>
                    <th style="width: 110px;">Date</th>
                    <th>Full Name</th>
                    <th style="width: 70px;">Age</th>
                    <th style="width: 140px;">Heard about</th>
                    <th style="width: 140px;">Housing</th>
                    <th style="width: 180px;">Permissions</th>
                    <th style="width: 160px;">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for r in records %}
                    <tr>
                        <td>{{ r.date ? r.date|date('Y-m-d') : '' }}</td>

                        <td>
                            <button type="button"
                                    class="btn btn-link p-0 text-start ia-toggle"
                                    data-target="ia-actions-{{ r.uuid }}"
                                    aria-expanded="false">
                                {{ r.fullName }}
                            </button>

                            <div class="text-muted small">
                                UUID: {{ r.uuid }}
                            </div>
                        </td>

                        <td>{{ r.age }}</td>
                        <td>{{ r.heardAbout }}</td>
                        <td>
                            {{ r.housing }}
                            {% if r.housing == 'other' and r.housingOther %}
                                <small class="text-muted">— {{ r.housingOther }}</small>
                            {% endif %}
                        </td>
                        <td>
                            {% if r.permissions is iterable and r.permissions|length > 0 %}
                                {{ r.permissions|join(', ') }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>

                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               href="{{ path('app_independent_age_action_new', {recordUuid: r.uuid}) }}">
                                Add action
                            </a>
                        </td>
                    </tr>

                    <tr id="ia-actions-{{ r.uuid }}" class="d-none">
                        <td colspan="7">
                            <div class="card">
                                <div class="card-body p-3">
                                    <h6 class="mb-2">Actions</h6>

                                    {% if r.actions is defined and r.actions|length > 0 %}
                                        <div class="table-responsive">
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                <tr>
                                                    <th style="width: 120px;">Date</th>
                                                    <th>Action</th>
                                                    <th style="width: 140px;">Outcome</th>
                                                    <th style="width: 180px;">Manage</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                {% for a in r.actions %}
                                                    <tr>
                                                        <td>{{ a.date ? a.date|date('Y-m-d') : '' }}</td>
                                                        <td style="white-space: pre-wrap;">{{ a.action }}</td>
                                                        <td>{{ a.outcome is not null ? a.outcome : '—' }}</td>
                                                        <td class="d-flex gap-2">
                                                            <a class="btn btn-sm btn-outline-secondary"
                                                               href="{{ path('app_independent_age_action_edit', {actionUuid: a.uuid}) }}">
                                                                Edit
                                                            </a>

                                                            <form method="post"
                                                                  action="{{ path('app_independent_age_action_delete', {actionUuid: a.uuid}) }}"
                                                                  onsubmit="return confirm('Delete this action?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_independent_age_action_' ~ a.uuid) }}">
                                                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% else %}
                                        <div class="text-muted">No actions recorded for this customer.</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-muted">No records yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.ia-toggle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = btn.getAttribute('data-target');
                    const row = document.getElementById(id);
                    if (!row) return;

                    const isHidden = row.classList.contains('d-none');
                    row.classList.toggle('d-none');
                    btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
                });
            });
        });
    </script>
{% endblock %}
