<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {% block stylesheets %}
        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
        <!-- FullCalendar CSS -->
       <!-- <link href="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.6/main.min.css" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/@fullcalendar/daygrid@6.1.6/main.min.css" rel="stylesheet" /> -->

        <!-- main app CSS -->
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
<!-- Top Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">Your Brand</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <!-- Add other navigation items here -->
            </ul>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="btn btn-danger">Logout</a>
            {% endif %}
        </div>
    </div>
</nav>

<!--
  Button that toggles the offcanvas sidebar.
-->
<button
        class="offcanvas-btn"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebarOffcanvas"
        aria-controls="sidebarOffcanvas"
>
    <span class="vertical-menu-text">Menu</span>
</button>


<!-- Bootstrap Offcanvas Sidebar -->
<div
        class="offcanvas offcanvas-start"
        tabindex="-1"
        id="sidebarOffcanvas"
        aria-labelledby="sidebarOffcanvasLabel"
>
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">Menu</h5>
        <button
                type="button"
                class="btn-close text-reset"
                data-bs-dismiss="offcanvas"
                aria-label="Close"
        ></button>
    </div>
    <div class="offcanvas-body">
        <!-- Put sidebar nav content/links here -->
        <ul class="list-group list-group-flush">
            <!-- Room Booking Heading -->
            <li class="list-group-item fw-bold">Room Booking</li>
            <li class="list-group-item">
                <a href="{{ path('app_calendar') }}">Calendar</a>
            </li>

            <!-- Spacing or Divider -->
            <li class="list-group-item bg-light border-0">&nbsp;</li>

            <!-- Customers Heading -->
            <li class="list-group-item fw-bold">Customers</li>
            <li class="list-group-item">
                <a href="{{ path('app_customer_index') }}">Customers</a>
            </li>

            <!-- Spacing or Divider -->
            <li class="list-group-item bg-light border-0">&nbsp;</li>

            <!-- Suppliers Heading -->
            <li class="list-group-item fw-bold">Suppliers</li>
            <li class="list-group-item">
                <a href="{{ path('app_supplier_index') }}">Suppliers</a>
            </li>

            <!-- Transactions heading -->
            <li class="list-group-item fw-bold">Transactions</li>
            <li class="list-group-item">
                <a href="{{ path('app_transaction_index') }}">Transactions</a>
            </li>
            <!-- Add more links as desired, e.g. new customer -->
            {#
            <li class="list-group-item">
                <a href="{{ path('app_customer_new') }}">Add Customer</a>
            </li>
            #}
        </ul>
    </div>
</div>

<!-- Main content container (optional) -->
<div class="container mt-4">
    {% block body %}{% endblock %}
</div>

{% block javascripts %}
    <!-- Bootstrap JavaScript Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    {{ encore_entry_script_tags('app') }}
{#    {% if app.request.attributes.get('_route') == 'app_booking' %}#}
{#        {{ encore_entry_script_tags('booking') }}#}
{#    {% endif %}#}

{% endblock %}
</body>
</html>
