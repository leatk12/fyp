{% extends 'base.html.twig' %}

{% block title %}Booking Page{% endblock %}

{% block body %}
    <h2>Booking for {{ date }}</h2>
    <div id="booking-grid"
         style="display: grid; grid-template-columns: auto repeat({{ rooms|length }}, 1fr);
                 gap: 1px; background: lightgray; max-width: 100%; margin: 50px auto;">
        <!-- Column Headers -->
        <div></div> <!-- Empty cell for time column -->
        {% for room in rooms %}
            <div style="background: #ddd; text-align: center; padding: 10px; font-weight: bold;">
                {{ room.roomName }}
            </div>
        {% endfor %}

        <!-- Time and Room Slots -->
        {% for hour in 8..20 %}
            <div style="background: #eee; text-align: center; padding: 10px; font-weight: bold;">
                {{ hour }}:00
            </div>
            {% for room in rooms %}
                <div class="time-slot"
                     data-room-id="{{ room.roomName }}"
                     data-room-name="{{ room.roomName }}"
                     data-time="{{ hour }}"
                     style="background: white; height: 50px; cursor: pointer; border: 1px solid #ccc;">
                    <!-- This slot might get dynamically assigned .booked in JS -->
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- 1) Existing overlay + creation modal -->
    <div id="modalOverlay"></div>

    <div id="bookingModal">
        <form id="bookingForm">
            <h3>Create Booking</h3>

            <!-- Room and Time -->
            <label for="bookingRoom">Room:</label>
            <input type="text" id="bookingRoom" readonly><br>

            <label for="bookingStart">Start Time:</label>
            <input type="time" id="bookingStart" readonly><br>

            <label for="bookingEnd">End Time:</label>
            <input type="time" id="bookingEnd" readonly><br>

            <label for="bookingDate">Date:</label>
            <input type="date" id="bookingDate" value="{{ date }}" readonly><br>

            <!-- Customer Information -->
            <label for="existingCustomer">Select Customer:</label>
            <select id="existingCustomer">
                <option value="" disabled selected>Select an existing customer</option>
            </select>
            <button type="button" id="addNewCustomer">Add New Customer</button><br>

            <!-- New Customer Fields (hidden by default) -->
            <div id="newCustomerFields" style="display: none;">
                <label for="organisation">Organisation:</label>
                <input type="text" id="organisation"><br>

                <label for="representative">Representative:</label>
                <input type="text" id="representative"><br>

                <label for="phone">Phone:</label>
                <input type="tel" id="phone"><br>

                <label for="email">Email:</label>
                <input type="email" id="email"><br>

                <!-- "Add" button for AJAX customer creation -->
                <button type="button" id="addCustomerAjax">Add</button>
            </div>

            <!-- Recurrence Field -->
            <label for="recurring">Recurring:</label>
            <select id="recurring">
                <option value="none" selected>None</option>
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
                <option value="yearly">Yearly</option>
            </select><br>

            <button type="submit">Save Booking</button>
            <button type="button" id="cancelBooking">Cancel</button>
        </form>
    </div>

    <!-- 2) New overlay + edit modal -->
    <div id="editBookingOverlay"></div>

    <div id="editBookingModal">
        <form id="editBookingForm">
            <h3>Edit Booking</h3>

            <!-- Hidden ID to know which booking we are editing -->
            <input type="hidden" id="editBookingId">

            <label for="editBookingRoom">Room:</label>
            <input type="text" id="editBookingRoom" readonly><br>

            <label for="editBookingStart">Start Time:</label>
            <input type="time" id="editBookingStart"><br>

            <label for="editBookingEnd">End Time:</label>
            <input type="time" id="editBookingEnd"><br>

            <label for="editBookingDate">Date:</label>
            <input type="date" id="editBookingDate"><br>

            <!-- For booking customer info -->
            <label for="editOrganisation">Organisation:</label>
            <input type="text" id="editOrganisation"><br>

            <label for="editRepresentative">Representative:</label>
            <input type="text" id="editRepresentative"><br>

            <label for="editPhone">Phone:</label>
            <input type="text" id="editPhone"><br>

            <label for="editEmail">Email:</label>
            <input type="email" id="editEmail"><br>

            <button type="submit" id="updateBookingBtn">Update Booking</button>
            <button type="button" id="deleteBookingBtn">Delete Booking</button>
            <button type="button" id="cancelEditBooking">Cancel</button>
        </form>
    </div>
{% endblock %}
