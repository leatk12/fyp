{% extends 'base.html.twig' %}

{% block title %}Bookings Report{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3 no-print">
            <h2 class="mb-0">Bookings Report</h2>
            <div>
                <a href="{{ path('app_calendar') }}" class="btn btn-outline-secondary">← Calendar</a>
                <button id="printBtn" class="btn btn-primary ms-2">Print</button>
            </div>
        </div>

        <div class="card no-print">
            <div class="card-body">
                <form id="rangeForm" class="row g-3">
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Start date</label>
                        <input type="date" id="startDate" class="form-control" required>
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label">End date</label>
                        <input type="date" id="endDate" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Presets</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary preset" data-range="day">Today</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset" data-range="week">Next 7 days</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset" data-range="2weeks">Next 14 days</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset" data-range="month">Next 30 days</button>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-success">Load</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <div class="d-flex justify-content-between align-items-end">
                <div>
                    <h5 id="rangeSummary" class="mb-1">No range selected</h5>
                    <small id="countSummary" class="text-muted"></small>
                </div>
            </div>

            <div class="table-responsive mt-3">
                <table class="table table-sm table-striped" id="reportTable">
                    <thead>
                    <tr>
                        <th style="width: 110px;">Date</th>
                        <th style="width: 90px;">Start</th>
                        <th style="width: 90px;">End</th>
                        <th>Room</th>
                        <th>Booked By</th>
                        <th style="width: 110px;">Cost</th>
                    </tr>
                    </thead>
                    <tbody>
                    <!-- rows injected by JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('report') }}
    <style>
        @media print {
            .no-print, .no-print * { display: none !important; }
            body { margin: 0.5cm; }
            table { font-size: 12px; }
            th, td { padding: 4px 6px !important; }
        }
    </style>
{% endblock %}
