{% extends 'base.html.twig' %}

{% block title %}Customers {% endblock %}

{% block body %}
<h1>Customers</h1>

<p>
    <a href="{{ path('app_customer_new') }}" class="btn btn-primary">Create New Customer</a>
</p>

{% if app.session.flashBag.has('success') %}
    <div class="alert alert-success">
        {{ app.session.flashBag.get('success')|join('.') }}
    </div>
{% endif %}


<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Organisation</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for customer in customers %}
        <tr>
            <td>{{ customer.name }}</td>
            <td>{{ customer.organisation }}</td>
            <td>{{ customer.email }}</td>
            <td>{{ customer.phone }}</td>
            <td>{{  customer.address }}</td>
            <td>
                <a href="{{ path('app_customer_edit', {id: customer.id}) }}" class="btn btn-sm btn-secondary">Edit</a>
                <form action ="{{ path('app_customer_delete', {id: customer.id}) }}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure');">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    {% endfor %}
    </tbody>

</table>

{% endblock %}