{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="d-flex flex-wrap justify-content-between
                align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2">{{ title }}</h1>

        <p class="text-muted mb-0">
            {{ record.fullName }}
        </p>
    </div>

    <a href="{{ path('app_hub_view', {
            uuid: record.uuid
        }) }}"
       class="btn btn-outline-secondary">
        Back to record
    </a>
</div>

{% include 'hub/_flashes.html.twig' %}

<div class="card mb-4">
    <div class="card-body">
        {{ form_start(form) }}

        {{ form_errors(form) }}
        {{ form_row(form.date) }}
        {{ form_row(form.actionLocation) }}
        {{ form_row(form.actionLocationOther) }}
        {{ form_row(form.action) }}
        {{ form_row(form.achievements) }}
        {{ form_row(form.outcome) }}

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-success">
                Save action
            </button>

            <a href="{{ path('app_hub_view', {
                        uuid: record.uuid
                    }) }}"
               class="btn btn-secondary">
                Cancel
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}