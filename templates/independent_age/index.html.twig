{% extends 'base.html.twig' %}

{% block title %}Independent Age — Records{% endblock %}

{% block body %}
    {# templates/independent_age/index.html.twig #}
    <!-- DEPLOY MARKER: 2026-01-28 14:00 -->

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Independent Age — Records</h2>
            <a href="{{ path('app_independent_age_new') }}" class="btn btn-primary">New record</a>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mt-3">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="table-responsive mt-3">
            <table class="table table-sm table-striped align-middle">
                <thead>
                <tr>
                    <th style="width: 110px;">Date</th>
                    <th>Full Name</th>
                    <th style="width: 70px;">Age</th>
                    <th style="width: 140px;">Heard about</th>
                    <th style="width: 140px;">Housing</th>
                    <th style="width: 180px;">Permissions</th>
                    <th style="width: 260px;">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for r in records %}
                    <tr>
                        <td>{{ r.date ? r.date|date('Y-m-d') : '' }}</td>

                        <td>
                            <button type="button"
                                    class="btn btn-link p-0 text-start ia-toggle"
                                    data-target="ia-actions-{{ r.uuid }}"
                                    aria-expanded="false">
                                {{ r.fullName }}
                            </button>

                            <div class="text-muted small">
                                UUID: {{ r.uuid }}
                            </div>
                        </td>

                        <td>{{ r.age }}</td>
                        <td>{{ r.heardAbout }}</td>
                        <td>
                            {{ r.housing }}
                            {% if r.housing == 'other' and r.housingOther %}
                                <small class="text-muted">— {{ r.housingOther }}</small>
                            {% endif %}
                        </td>
                        <td>
                            {% if r.permissions is iterable and r.permissions|length > 0 %}
                                {{ r.permissions|join(', ') }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>

                        <td class="d-flex gap-2 flex-wrap">
                            <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary ia-view"
                                    data-url="{{ path('app_independent_age_view', { uuid: r.uuid }) }}"
                                    data-title="View record"
                                    data-bs-toggle="modal"
                                    data-bs-target="#iaRecordModal"
                            >
                                View
                            </button>

                            <button
                                    type="button"
                                    class="btn btn-sm btn-outline-primary ia-edit"
                                    data-url="{{ path('app_independent_age_edit', { uuid: r.uuid }) }}"
                                    data-title="Edit record"
                                    data-bs-toggle="modal"
                                    data-bs-target="#iaRecordModal"
                            >
                                Edit
                            </button>

                            <form method="post"
                                  action="{{ path('app_independent_age_delete', { uuid: r.uuid }) }}"
                                  onsubmit="return confirm('Delete this record? This will also delete all actions for it.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_independent_age_record_' ~ r.uuid) }}">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>

                            <a class="btn btn-sm btn-outline-success"
                               href="{{ path('app_independent_age_action_new', { recordUuid: r.uuid }) }}">
                                Add action
                            </a>
                        </td>
                    </tr>

                    <tr id="ia-actions-{{ r.uuid }}" class="d-none">
                        <td colspan="7">
                            <div class="card">
                                <div class="card-body p-3">
                                    <h6 class="mb-2">Actions</h6>

                                    {% if r.actions is defined and r.actions|length > 0 %}
                                        <div class="table-responsive">
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                <tr>
                                                    <th style="width: 120px;">Date</th>
                                                    <th>Action</th>
                                                    <th style="width: 140px;">Outcome</th>
                                                    <th style="width: 180px;">Manage</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                {% for a in r.actions %}
                                                    <tr>
                                                        <td>{{ a.date ? a.date|date('Y-m-d') : '' }}</td>
                                                        <td style="white-space: pre-wrap;">{{ a.action }}</td>
                                                        <td>{{ a.outcome is not null ? a.outcome : '—' }}</td>
                                                        <td class="d-flex gap-2">
                                                            <a class="btn btn-sm btn-outline-secondary"
                                                               href="{{ path('app_independent_age_action_edit', { actionUuid: a.uuid }) }}">
                                                                Edit
                                                            </a>

                                                            <form method="post"
                                                                  action="{{ path('app_independent_age_action_delete', { actionUuid: a.uuid }) }}"
                                                                  onsubmit="return confirm('Delete this action?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_independent_age_action_' ~ a.uuid) }}">
                                                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    {% else %}
                                        <div class="text-muted">No actions recorded for this customer.</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-muted">No records yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Shared modal for both View and Edit #}
    <div class="modal fade" id="iaRecordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="iaRecordModalTitle">Record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="iaRecordModalBody">
                    <div class="text-muted">Loading…</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function initIndependentAgeToggles() {
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.ia-toggle');
                if (!btn) return;

                const id = btn.getAttribute('data-target');
                const row = document.getElementById(id);
                if (!row) return;

                const willShow = row.classList.contains('d-none');
                row.classList.toggle('d-none');
                btn.setAttribute('aria-expanded', willShow ? 'true' : 'false');
            }, { passive: true });
        }

        async function loadIntoModal(url, title) {
            const titleEl = document.getElementById('iaRecordModalTitle');
            const bodyEl = document.getElementById('iaRecordModalBody');

            titleEl.textContent = title || 'Record';
            bodyEl.innerHTML = '<div class="text-muted">Loading…</div>';

            const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!res.ok) {
                bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Failed to load content.</div>';
                return;
            }

            bodyEl.innerHTML = await res.text();
        }

        function initIndependentAgeRecordModals() {
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.ia-view, .ia-edit');
                if (!btn) return;

                const url = btn.getAttribute('data-url');
                const title = btn.getAttribute('data-title') || 'Record';
                if (!url) return;

                loadIntoModal(url, title);
            });

            document.addEventListener('submit', async function (e) {
                const form = e.target.closest('#ia-edit-form');
                if (!form) return;

                e.preventDefault();

                const bodyEl = document.getElementById('iaRecordModalBody');
                const formData = new FormData(form);

                const res = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const contentType = (res.headers.get('content-type') || '').toLowerCase();

                if (contentType.includes('application/json')) {
                    const data = await res.json();
                    if (data && data.ok && data.redirect) {
                        window.location.href = data.redirect;
                        return;
                    }
                    bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Unexpected response.</div>';
                    return;
                }

                bodyEl.innerHTML = await res.text();
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initIndependentAgeToggles();
            initIndependentAgeRecordModals();
        });

        document.addEventListener('turbo:load', function () {
            initIndependentAgeToggles();
            initIndependentAgeRecordModals();
        });
    </script>

{% endblock %}
