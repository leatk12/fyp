{% extends 'base.html.twig' %}

{% block title %}Suppliers{% endblock %}

{% block body %}
<h1>Suppliers</h1>

<p>
    <a href="{{ path('app_supplier_new') }}" class="btn btn-primary">Create New Supplier</a>
</p>

{% if app.session.flashBag.has('success') %}
    <div class="alert alert-success">
        {{ app.session.flashBag.get('success')|join('.') }}
    </div>
{% endif %}

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Organisation</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Address></th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    {% for supplier in suppliers %}
        <tr>
            <td>{{ supplier.name }}</td>
            <td>{{ supplier.organisation }}</td>
            <td>{{ supplier.email }}</td>
            <td>{{ supplier.phone }}</td>
            <td>{{ supplier.address }}</td>
            <td>
                <a href="{{ path('app_supplier_edit', {id: supplier.id}) }}" class="btn btn-sm btn-secondary">Edit</a>
                <form action="{{ path('app_supplier_delete', {id: supplier.id}) }}" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}